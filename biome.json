{
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"useTemplate": "off"
			},
			"correctness": {
				"noUnusedImports": {
					"fix": "safe",
					"level": "error"
				}
			},
			"a11y": {
				"useMediaCaption": "off"
			},
			"suspicious": {
				"noUnknownAtRules": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineWidth": 120
	},
	"javascript": {
		"formatter": {
			"trailingCommas": "none"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"files": {
		"includes": ["**", "!**/node_modules", "!**/.next", "!**/.idea", "!**/public"]
	}
}
