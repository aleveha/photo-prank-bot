{
	"name": "photo-prank-bot",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"tunnel": "ssh -R 80:localhost:3000 localhost.run",
		"build": "next build",
		"start": "next start",
		"format": "biome format --write .",
		"db:g": "bun run --env-file=.env.local drizzle-kit generate --name",
		"db:m": "bun run --bun drizzle-kit migrate",
		"db:ui": "bun run --env-file=.env.local drizzle-kit studio",
		"typecheck": "tsc --noEmit",
		"cleanup": "bun --bun src/scripts/cleanup.ts"
	},
	"dependencies": {
		"@grammyjs/auto-retry": "^2.0.2",
		"@grammyjs/commands": "^1.4.0",
		"@grammyjs/i18n": "^1.1.2",
		"@grammyjs/ratelimiter": "^1.2.1",
		"@radix-ui/react-dropdown-menu": "^2.2.1",
		"@roziscoding/grammy-autoquote": "^2.0.9",
		"canvas-confetti": "^1.9.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.4",
		"envalid": "^9.0.0",
		"grammy": "1.46.0",
		"ky": "^2.2.0",
		"lucide-react": "^1.67.0",
		"next": "15.5.29",
		"next-intl": "^3.26.5",
		"postgres": "^3.4.9",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwind-merge": "^3.7.0",
		"tailwindcss-animate": "^1.0.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/bun": "^1.4.4",
		"@types/canvas-confetti": "^1.9.0",
		"@types/node": "^22.20.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"autoprefixer": "^10.6.2",
		"drizzle-kit": "^0.31.11",
		"postcss": "^8.5.32",
		"tailwindcss": "^3.4.19",
		"typescript": "^5.9.3"
	}
}
