{
	"name": "photo-prank-bot",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "bun run typecheck && bun --bun startup && bunx next dev",
		"tunnel": "ssh -R make-them-smile.lhr.rocks:80:localhost:3000 plan@localhost.run",
		"build": "bun run typecheck && bun run db:m && next build && bun run startup",
		"start": "next start",
		"format": "biome format --write .",
		"db:g": "bun run --env-file=.env.local drizzle-kit generate --name",
		"db:m": "bun run --bun drizzle-kit migrate",
		"db:ui": "bun run --env-file=.env.local drizzle-kit studio",
		"startup": "bun --bun src/scripts/startup.ts",
		"typecheck": "tsc --noEmit",
		"cleanup": "bun --bun src/scripts/cleanup.ts"
	},
	"dependencies": {
		"@grammyjs/auto-retry": "^2.0.2",
		"@grammyjs/commands": "^1.0.3",
		"@grammyjs/i18n": "^1.1.2",
		"@grammyjs/parse-mode": "^1.10.0",
		"@grammyjs/ratelimiter": "^1.2.1",
		"@radix-ui/react-dropdown-menu": "^2.1.4",
		"@roziscoding/grammy-autoquote": "^2.0.8",
		"@vercel/speed-insights": "^1.0.12",
		"canvas-confetti": "^1.9.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.33.0",
		"envalid": "^8.0.0",
		"grammy": "^1.33.0",
		"lucide-react": "^0.469.0",
		"next": "^15.1.3",
		"next-intl": "^3.26.3",
		"postgres": "^3.4.4",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"tailwind-merge": "^2.6.0",
		"tailwindcss-animate": "^1.0.7"
	},
	"devDependencies": {
		"@biomejs/biome": "1.8.3",
		"@types/bun": "^1.1.8",
		"@types/canvas-confetti": "^1.9.0",
		"@types/node": "^20",
		"@types/react": "^19.0.2",
		"@types/react-dom": "^19.0.2",
		"autoprefixer": "^10.4.20",
		"drizzle-kit": "^0.24.2",
		"postcss": "^8.4.44",
		"tailwindcss": "^3.4.17",
		"typescript": "^5"
	}
}
